{
  "enabled": true,
  "name": "Verifier tests",
  "description": "When git.js, witness.js or duel.js changes, rerun the tests: the verifier is the centerpiece of the project.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["src/git.js", "src/witness.js", "src/duel.js", "test/*.test.js"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run `npm test`. If a test fails, fix the code (not the test) unless spec R3 has changed. Tell me what was verified."
  }
}
